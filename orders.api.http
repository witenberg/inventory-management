### 14. Create Order - Multiple Products (Volume Discount on Total)
# Total quantity: 3 + 4 = 7 units -> 10% discount
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "customerId": "695a5c9c79b4b500ad27dcb1",
    "products": [
        {
            "productId": "695a5c9379b4b500ad27dca3",
            "quantity": 3
        },
        {
            "productId": "695a5c9379b4b500ad27dca5",
            "quantity": 4
        }
    ]
}

