@baseUrl = http://localhost:3000
@contentType = application/json

### ========================================
### SETUP - Seed Test Data
### ========================================

### 0a. Seed Products
POST {{baseUrl}}/seed/products?clearExisting=true

### 0b. Seed Customers
# Creates 8 test customers (3 US, 3 Europe, 2 Asia)
POST {{baseUrl}}/seed/customers?clearExisting=true

### ========================================
### CUSTOMER MANAGEMENT
### ========================================

### 1. Create Customer - US Location
POST {{baseUrl}}/customers
Content-Type: {{contentType}}

{
    "name": "John Doe",
    "email": "john.doe@example.com",
    "location": "US"
}

### 2. Create Customer - Europe Location
POST {{baseUrl}}/customers
Content-Type: {{contentType}}

{
    "name": "Anna Kowalska",
    "email": "anna.kowalska@example.pl",
    "location": "EUROPE"
}

### 3. Create Customer - Asia Location
POST {{baseUrl}}/customers
Content-Type: {{contentType}}

{
    "name": "Li Wei",
    "email": "li.wei@example.cn",
    "location": "ASIA"
}

### 4. Get All Customers
GET {{baseUrl}}/customers

### 5. Get Customer by ID
# Replace with actual customer ID from previous responses
GET {{baseUrl}}/customers/695a5c9c79b4b500ad27dcac

### 6. Create Customer (Validation Error - Duplicate Email)
POST {{baseUrl}}/customers
Content-Type: {{contentType}}

{
    "name": "John Duplicate",
    "email": "john.doe@example.com",
    "location": "US"
}

### 7. Create Customer (Validation Error - Invalid Location)
POST {{baseUrl}}/customers
Content-Type: {{contentType}}

{
    "name": "Invalid Location",
    "email": "invalid@example.com",
    "location": "INVALID"
}

### ========================================
### ORDER MANAGEMENT - BASIC ORDERS
### ========================================

### 8. Create Order - Simple Order (US Customer)
# Standard pricing, no discounts (less than 5 units)
# Replace customerId and productIds with actual IDs
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "customerId": "695a5c9c79b4b500ad27dcac",
    "products": [
        {
            "productId": "695a5c9379b4b500ad27dca3",
            "quantity": 2
        }
    ]
}

### 9. Create Order - Europe Customer (Location Pricing)
# Prices increased by 15% due to VAT
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "customerId": "695a5c9c79b4b500ad27dcae",
    "products": [
        {
            "productId": "695a5c9379b4b500ad27dca3",
            "quantity": 3
        }
    ]
}

### 10. Create Order - Asia Customer (Location Pricing)
# Prices reduced by 5% due to lower logistics costs
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
    "customerId": "695a5c9c79b4b500ad27dcb1",
    "products": [
        {
            "productId": "695a5c9379b4b500ad27dca3",
            "quantity": 2
        }
    ]
}

